<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.papaya.claims.claim.domain.mapper.SystemAuditMapper">
  <insert id="append" parameterType="com.papaya.claims.claim.domain.persistence.SystemAuditRow">
    INSERT INTO system_operation_audit(id,action,resource,resource_id,actor_id,correlation_id,outcome,error_type,occurred_at)
    VALUES(#{id},#{action},#{resource},#{resourceId},#{actorId},#{correlationId},#{outcome},#{errorType},#{occurredAt})
  </insert>
</mapper>
