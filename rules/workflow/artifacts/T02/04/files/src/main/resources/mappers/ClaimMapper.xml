<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.papaya.claims.persistence.ClaimMapper"><resultMap id="claim" type="com.papaya.claims.persistence.ClaimRow"><constructor><idArg column="id" javaType="java.util.UUID"/><arg column="member_id" javaType="java.lang.String"/><arg column="state" javaType="java.lang.String"/><arg column="policy_limit" javaType="java.math.BigDecimal"/><arg column="currency" javaType="java.lang.String"/><arg column="facts" javaType="java.lang.String"/><arg column="information_requests" javaType="_int"/><arg column="version" javaType="_long"/><arg column="assessment_started_at" javaType="java.time.Instant"/><arg column="last_information_requested_at" javaType="java.time.Instant"/></constructor></resultMap><sql id="cols">id,member_id,state,policy_limit,currency,facts::text facts,information_requests,version,assessment_started_at,last_information_requested_at</sql><insert id="insert">INSERT INTO claims(id,member_id,state,policy_limit,currency,facts,information_requests,version,assessment_started_at,last_information_requested_at) VALUES(#{id},#{memberId},#{state},#{policyLimit},#{currency},CAST(#{facts} AS jsonb),#{informationRequests},#{version},#{assessmentStartedAt},#{lastInformationRequestedAt})</insert><select id="find" resultMap="claim">SELECT <include refid="cols"/> FROM claims WHERE id=#{id}</select><select id="findForUpdate" resultMap="claim">SELECT <include refid="cols"/> FROM claims WHERE id=#{id} FOR UPDATE</select><select id="list" resultMap="claim">SELECT <include refid="cols"/> FROM claims ORDER BY created_at,id</select><update id="compareAndSet">UPDATE claims SET member_id=#{row.memberId},state=#{row.state},policy_limit=#{row.policyLimit},currency=#{row.currency},facts=CAST(#{row.facts} AS jsonb),information_requests=#{row.informationRequests},version=#{row.version},assessment_started_at=#{row.assessmentStartedAt},last_information_requested_at=#{row.lastInformationRequestedAt},updated_at=clock_timestamp() WHERE id=#{row.id} AND version=#{expectedVersion} AND #{row.version}=#{expectedVersion}+1</update></mapper>
