+<?xml version="1.0" encoding="UTF-8" ?>
+<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
+<mapper namespace="com.papaya.claims.claim.domain.mapper.ClaimMapper">
+ <resultMap id="claim" type="com.papaya.claims.claim.domain.persistence.ClaimRow">
+  <constructor><idArg column="id" javaType="java.util.UUID"/><arg column="member_id" javaType="String"/><arg column="state" javaType="String"/><arg column="policy_limit" javaType="java.math.BigDecimal"/><arg column="currency" javaType="String"/><arg column="facts" javaType="String"/><arg column="information_requests" javaType="int"/><arg column="version" javaType="long"/><arg column="assessment_started_at" javaType="java.time.Instant"/><arg column="last_information_requested_at" javaType="java.time.Instant"/><arg column="last_information_received_at" javaType="java.time.Instant"/><arg column="rejected_at" javaType="java.time.Instant"/><arg column="member_acknowledged_rejection_at" javaType="java.time.Instant"/><arg column="created_at" javaType="java.time.Instant"/><arg column="updated_at" javaType="java.time.Instant"/></constructor>
+ </resultMap>
+ <sql id="cols">id,member_id,state,policy_limit,currency,facts::text AS facts,information_requests,version,assessment_started_at,last_information_requested_at,last_information_received_at,rejected_at,member_acknowledged_rejection_at,created_at,updated_at</sql>
+ <insert id="insert">INSERT INTO claims(id,member_id,state,policy_limit,currency,facts,information_requests,version,assessment_started_at,last_information_requested_at,last_information_received_at,rejected_at,member_acknowledged_rejection_at) VALUES(#{id},#{memberId},#{state},#{policyLimit},#{currency},CAST(#{facts} AS jsonb),#{informationRequests},#{version},#{assessmentStartedAt},#{lastInformationRequestedAt},#{lastInformationReceivedAt},#{rejectedAt},#{memberAcknowledgedRejectionAt})</insert>
+ <select id="find" resultMap="claim">SELECT <include refid="cols"/> FROM claims WHERE id=#{id}</select>
+ <select id="findForUpdate" resultMap="claim">SELECT <include refid="cols"/> FROM claims WHERE id=#{id} FOR UPDATE</select>
+ <select id="pageAll" resultMap="claim">SELECT <include refid="cols"/> FROM claims ORDER BY created_at DESC,id LIMIT #{limit} OFFSET #{offset}</select><select id="countAll" resultType="long">SELECT count(*) FROM claims</select>
+ <select id="pageMember" resultMap="claim">SELECT <include refid="cols"/> FROM claims WHERE member_id=#{memberId} ORDER BY created_at DESC,id LIMIT #{limit} OFFSET #{offset}</select><select id="countMember" resultType="long">SELECT count(*) FROM claims WHERE member_id=#{memberId}</select>
+ <update id="compareAndSet">UPDATE claims SET state=#{r.state},facts=CAST(#{r.facts} AS jsonb),information_requests=#{r.informationRequests},assessment_started_at=#{r.assessmentStartedAt},last_information_requested_at=#{r.lastInformationRequestedAt},last_information_received_at=#{r.lastInformationReceivedAt},rejected_at=#{r.rejectedAt},member_acknowledged_rejection_at=#{r.memberAcknowledgedRejectionAt},version=version+1,updated_at=clock_timestamp() WHERE id=#{r.id} AND version=#{expectedVersion}</update>
+</mapper>
