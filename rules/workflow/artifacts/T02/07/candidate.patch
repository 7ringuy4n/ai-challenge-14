+import java.util.UUID;
+
+/** Persistence port for claim state. Mutations must participate in the caller's transaction. */
+public interface ClaimRepository {
+    void insert(Claim claim);
+    Optional<Claim> find(UUID claimId);
+    Optional<Claim> findForUpdate(UUID claimId);
+    PageResult<Claim> listVisible(PageRequest page, Actor actor);
+    boolean compareAndSet(Claim claim, long expectedVersion);
+}
