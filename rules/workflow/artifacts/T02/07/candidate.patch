+package com.papaya.claims.claim.domain;
+
+import java.time.Instant;
+import java.util.List;
+import java.util.UUID;
+
+/** Durable local outbox port; delivery is at-least-once and consumers must be idempotent. */
+public interface OutboxRepository {
+    void enqueue(Message message);
+    List<Message> claimDue(Instant now, int limit);
+    boolean markDelivered(UUID id, Instant deliveredAt);
+    boolean markFailed(UUID id, String safeError, Instant retryAt);
+
+    record Message(UUID id, UUID claimId, String effect, String payload,
+                   int attempts, Instant availableAt) { }
+}
diff --git a/src/main/resources/db/changelog/changes/002-persistence.sql b/src/main/resources/db/changelog/changes/002-persistence.sql
new file mode 100644
index 0000000..1111111
--- /dev/null
