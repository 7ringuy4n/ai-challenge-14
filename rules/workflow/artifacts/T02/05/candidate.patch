+                new BigDecimal("100.00"), "USD", Map.of("proof", true), 1, 3,
+                assessmentStartedAt, lastInformationRequestedAt);
+
+        harness.claims().insert(claim);
+        ClaimSnapshot persisted = harness.claims().find(claim.id()).orElseThrow();
+
+        assertThat(persisted.assessmentStartedAt())
+                .isEqualTo(assessmentStartedAt.truncatedTo(ChronoUnit.MICROS));
+        assertThat(persisted.lastInformationRequestedAt())
+                .isEqualTo(lastInformationRequestedAt.truncatedTo(ChronoUnit.MICROS));
