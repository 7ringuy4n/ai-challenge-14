<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.papaya.claims.persistence.AuditMapper"><resultMap id="audit" type="com.papaya.claims.persistence.AuditRow"><constructor><idArg column="audit_id" javaType="java.util.UUID"/><arg column="claim_id" javaType="java.util.UUID"/><arg column="sequence" javaType="long"/><arg column="occurred_at" javaType="java.time.Instant"/><arg column="from_state" javaType="java.lang.String"/><arg column="to_state" javaType="java.lang.String"/><arg column="user_id" javaType="java.lang.String"/><arg column="role" javaType="java.lang.String"/><arg column="notes" javaType="java.lang.String"/><arg column="config_version" javaType="java.lang.String"/><arg column="trace_id" javaType="java.lang.String"/></constructor></resultMap><insert id="append">INSERT INTO claim_audit(audit_id,claim_id,sequence,occurred_at,from_state,to_state,user_id,role,notes,config_version,trace_id) VALUES(#{auditId},#{claimId},#{sequence},#{timestamp},#{fromState},#{toState},#{userId},#{role},#{notes},#{configVersion},#{traceId})</insert><select id="findByClaimId" resultMap="audit">SELECT audit_id,claim_id,sequence,occurred_at,from_state,to_state,user_id,role,notes,config_version,trace_id FROM claim_audit WHERE claim_id=#{id} ORDER BY sequence,audit_id</select></mapper>
