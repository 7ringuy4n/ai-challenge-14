<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.papaya.claims.persistence.CommandMapper"><resultMap id="receipt" type="com.papaya.claims.persistence.ReceiptRow"><constructor><arg column="claim_id" javaType="java.util.UUID"/><arg column="user_id" javaType="java.lang.String"/><arg column="idempotency_key" javaType="java.lang.String"/><arg column="request_hash" javaType="java.lang.String"/><arg column="result" javaType="java.lang.String"/></constructor></resultMap><select id="find" resultMap="receipt">SELECT claim_id,user_id,idempotency_key,request_hash,result::text result FROM command_receipts WHERE claim_id=#{claimId} AND user_id=#{userId} AND idempotency_key=#{key}</select><insert id="insert">INSERT INTO command_receipts(claim_id,user_id,idempotency_key,request_hash,result) VALUES(#{claimId},#{userId},#{key},#{requestHash},CAST(#{result} AS jsonb))</insert></mapper>
