+package com.papaya.claims.claim.domain.persistence;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.List;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+
+class AuditImmutabilityIT extends PersistenceITSupport {
+    @Test
+    void runtimeCannotUpdateOrDeleteEitherAuditTable() throws Exception {
+        try (var connection = runtime()) {
+            UUID claimId = insertClaim(connection);
+            insertAuditRows(connection, claimId);
+            for (String table : List.of("claim_audit", "system_operation_audit")) {
+                for (String operation : List.of("UPDATE", "DELETE")) {
+                    String sql = table.equals("claim_audit")
+                            ? operation + " " + table + " SET reason='rewritten' WHERE claim_id='" + claimId + "'"
+                            : operation + " " + table + " WHERE resource_id='" + claimId + "'";
+                    var failure = org.assertj.core.api.Assertions.catchThrowable(() -> {
+                        try (var statement = connection.createStatement()) { statement.executeUpdate(sql); }
+                    });
+                    assertThat(failure).as(table + " " + operation).isNotNull();
+                }
+            }
+            try (var statement = connection.createStatement(); var rows = statement.executeQuery("SELECT (SELECT count(*) FROM claim_audit),(SELECT count(*) FROM system_operation_audit)")) {
+                assertThat(rows.next()).isTrue(); assertThat(rows.getLong(1)).isEqualTo(1); assertThat(rows.getLong(2)).isEqualTo(1);
+            }
+        }
+    }
+}
