+package com.papaya.claims.claim.domain.persistence;
+
+import java.sql.Connection;
+import java.sql.DriverManager;
+import java.sql.SQLException;
+import java.sql.Statement;
+import java.util.UUID;
+import liquibase.Contexts;
+import liquibase.LabelExpression;
+import liquibase.Liquibase;
+import liquibase.database.Database;
+import liquibase.database.DatabaseFactory;
+import liquibase.database.jvm.JdbcConnection;
+import liquibase.resource.ClassLoaderResourceAccessor;
+import org.junit.jupiter.api.BeforeAll;
+import org.testcontainers.containers.PostgreSQLContainer;
+import org.testcontainers.junit.jupiter.Container;
+import org.testcontainers.junit.jupiter.Testcontainers;
+
+@Testcontainers
+abstract class PersistenceITSupport {
+    @Container
+    static final PostgreSQLContainer<?> POSTGRES = new PostgreSQLContainer<>("postgres:16-alpine")
+            .withDatabaseName("claims")
+            .withUsername("bootstrap")
+            .withPassword("bootstrap-test");
+
+    @BeforeAll
+    static void provisionRolesAndApplyMigrations() throws Exception {
+        try (Connection bootstrap = DriverManager.getConnection(POSTGRES.getJdbcUrl(), POSTGRES.getUsername(), POSTGRES.getPassword());
+             Statement sql = bootstrap.createStatement()) {
+            sql.execute("CREATE ROLE claims_runtime LOGIN PASSWORD 'runtime-test' NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT");
+            sql.execute("CREATE ROLE claims_migration LOGIN PASSWORD 'migration-test' NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT");
+            sql.execute("ALTER SCHEMA public OWNER TO claims_migration");
+            sql.execute("GRANT CONNECT ON DATABASE claims TO claims_migration, claims_runtime");
+            sql.execute("GRANT USAGE, CREATE ON SCHEMA public TO claims_migration");
+        }
+        try (Connection migration = DriverManager.getConnection(POSTGRES.getJdbcUrl(), "claims_migration", "migration-test")) {
+            Database database = DatabaseFactory.getInstance().findCorrectDatabaseImplementation(new JdbcConnection(migration));
+            try (Liquibase liquibase = new Liquibase("db/changelog/db.changelog-master.yml", new ClassLoaderResourceAccessor(), database)) {
+                liquibase.update(new Contexts(), new LabelExpression());
+            }
+        }
+    }
+
+    static Connection runtime() throws SQLException {
+        return DriverManager.getConnection(POSTGRES.getJdbcUrl(), "claims_runtime", "runtime-test");
+    }
+
+    static UUID insertClaim(Connection connection) throws SQLException {
+        UUID id = UUID.randomUUID();
+        try (var statement = connection.prepareStatement("INSERT INTO claims(id,member_id,state,policy_limit,currency) VALUES(?, 'member-1','submitted',125.00,'USD')")) {
+            statement.setObject(1, id);
+            statement.executeUpdate();
+        }
+        return id;
+    }
+
+    static void insertAuditRows(Connection connection, UUID claimId) throws SQLException {
+        try (var claimAudit = connection.prepareStatement("INSERT INTO claim_audit(id,claim_id,sequence,occurred_at,to_state,actor_id,role,reason,correlation_id,workflow_version) VALUES(?, ?, 0, clock_timestamp(), 'submitted', 'member-1', 'member', 'created', 'corr-1', 'v1')");
+             var systemAudit = connection.prepareStatement("INSERT INTO system_operation_audit(id,action,resource,resource_id,actor_id,correlation_id,outcome,occurred_at) VALUES(?, 'claim.read', 'claim', ?, 'member-1', 'corr-1', 'SUCCESS', clock_timestamp())")) {
+            claimAudit.setObject(1, UUID.randomUUID()); claimAudit.setObject(2, claimId); claimAudit.executeUpdate();
+            systemAudit.setObject(1, UUID.randomUUID()); systemAudit.setString(2, claimId.toString()); systemAudit.executeUpdate();
+        }
+    }
+}
