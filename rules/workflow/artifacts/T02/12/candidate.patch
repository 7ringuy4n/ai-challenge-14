+package com.papaya.claims.claim.domain.persistence;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.sql.ResultSet;
+import org.junit.jupiter.api.Test;
+
+class ClaimPersistenceIT extends PersistenceITSupport {
+    @Test
+    void migrationOwnerIsRestrictedSchemaOwnerAndRuntimeCannotCreateObjects() throws Exception {
+        try (var connection = runtime(); var statement = connection.createStatement();
+             ResultSet roles = statement.executeQuery("SELECT rolname, rolsuper, rolcreatedb, rolcreaterole FROM pg_roles WHERE rolname IN ('claims_migration','claims_runtime') ORDER BY rolname")) {
+            assertThat(roles.next()).isTrue();
+            assertThat(roles.getString("rolname")).isEqualTo("claims_migration");
+            assertThat(roles.getBoolean("rolsuper")).isFalse();
+            assertThat(roles.getBoolean("rolcreatedb")).isFalse();
+            assertThat(roles.getBoolean("rolcreaterole")).isFalse();
+            assertThat(roles.next()).isTrue();
+            assertThat(roles.getString("rolname")).isEqualTo("claims_runtime");
+            assertThat(roles.getBoolean("rolsuper")).isFalse();
+            assertThat(roles.getBoolean("rolcreatedb")).isFalse();
+            assertThat(roles.getBoolean("rolcreaterole")).isFalse();
+            assertThat(roles.next()).isFalse();
+        }
+        try (var connection = runtime(); var statement = connection.createStatement()) {
+            try (ResultSet privileges = statement.executeQuery("SELECT has_schema_privilege('claims_migration','public','USAGE'), has_schema_privilege('claims_migration','public','CREATE'), has_schema_privilege('claims_runtime','public','USAGE'), has_schema_privilege('claims_runtime','public','CREATE')")) {
+                assertThat(privileges.next()).isTrue();
+                assertThat(privileges.getBoolean(1)).isTrue(); assertThat(privileges.getBoolean(2)).isTrue();
+                assertThat(privileges.getBoolean(3)).isTrue(); assertThat(privileges.getBoolean(4)).isFalse();
+            }
+            var failure = org.assertj.core.api.Assertions.catchThrowable(() -> statement.execute("CREATE TABLE runtime_must_not_create(id integer)"));
+            assertThat(failure).isNotNull();
+        }
+    }
+
+    @Test
+    void compareAndSetMappingDoesNotSetImmutableAggregateFields() throws Exception {
+        try (var mapper = getClass().getClassLoader().getResourceAsStream("sql/service/claim/ClaimMapper.xml")) {
+            assertThat(mapper).as("ClaimMapper.xml must be packaged for persistence tests").isNotNull();
+            String xml = new String(mapper.readAllBytes(), java.nio.charset.StandardCharsets.UTF_8);
+            String update = xml.substring(xml.indexOf("<update id=\"compareAndSet\">"), xml.indexOf("</update>", xml.indexOf("<update id=\"compareAndSet\">")));
+            assertThat(update).doesNotContain("member_id", "policy_limit", "currency");
+        }
+    }
+
+    @Test
+    void runtimeCanCreateAndReadClaimButCannotRewriteIdentityOrCoverage() throws Exception {
+        try (var connection = runtime()) {
+            var id = insertClaim(connection);
+            try (var read = connection.prepareStatement("SELECT member_id, policy_limit, currency FROM claims WHERE id=?")) {
+                read.setObject(1, id);
+                try (var row = read.executeQuery()) {
+                    assertThat(row.next()).isTrue();
+                    assertThat(row.getString(1)).isEqualTo("member-1");
+                    assertThat(row.getBigDecimal(2)).isEqualByComparingTo("125.00");
+                    assertThat(row.getString(3).trim()).isEqualTo("USD");
+                }
+            }
+            try (var update = connection.prepareStatement("UPDATE claims SET state='assessing', version=version+1 WHERE id=?")) {
+                update.setObject(1, id); assertThat(update.executeUpdate()).isEqualTo(1);
+            }
+            try (var read = connection.prepareStatement("SELECT member_id, policy_limit, currency FROM claims WHERE id=?")) {
+                read.setObject(1, id);
+                try (var row = read.executeQuery()) {
+                    assertThat(row.next()).isTrue();
+                    assertThat(row.getString(1)).isEqualTo("member-1");
+                    assertThat(row.getBigDecimal(2)).isEqualByComparingTo("125.00");
+                    assertThat(row.getString(3).trim()).isEqualTo("USD");
+                }
+            }
+        }
+    }
+}
