+package com.papaya.claims.claim.domain.persistence;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.sql.SQLException;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+
+class IdempotencyIT extends PersistenceITSupport {
+    @Test
+    void uniqueActorScopeKeyPreservesExactFingerprintAndJsonResult() throws Exception {
+        String fingerprint = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
+        String result = "{\"claimId\":\"" + UUID.randomUUID() + "\",\"state\":\"approved\",\"version\":7}";
+        try (var connection = runtime(); var insert = connection.prepareStatement("INSERT INTO command_receipts(id,actor_id,scope,idempotency_key,fingerprint,result_json) VALUES(?,?,?,?,?,?::jsonb)")) {
+            UUID id = UUID.randomUUID();
+            insert.setObject(1, id); insert.setString(2, "actor-1"); insert.setString(3, "claim.transition"); insert.setString(4, "request-1"); insert.setString(5, fingerprint); insert.setString(6, result);
+            assertThat(insert.executeUpdate()).isEqualTo(1);
+            try (var read = connection.prepareStatement("SELECT fingerprint, result_json = ?::jsonb AS same_result, result_json::text FROM command_receipts WHERE actor_id=? AND scope=? AND idempotency_key=?")) {
+                read.setString(1, result); read.setString(2, "actor-1"); read.setString(3, "claim.transition"); read.setString(4, "request-1");
+                try (var row = read.executeQuery()) {
+                    assertThat(row.next()).isTrue(); assertThat(row.getString(1)).isEqualTo(fingerprint);
+                    assertThat(row.getBoolean(2)).isTrue(); assertThat(row.getString(3)).contains("approved").contains("\"version\": 7");
+                }
+            }
+            var duplicate = org.assertj.core.api.Assertions.catchThrowable(() -> insert.executeUpdate());
+            assertThat(duplicate).isInstanceOf(SQLException.class);
+            try (var count = connection.prepareStatement("SELECT count(*) FROM command_receipts WHERE actor_id=? AND scope=? AND idempotency_key=?")) {
+                count.setString(1, "actor-1"); count.setString(2, "claim.transition"); count.setString(3, "request-1");
+                try (var rows = count.executeQuery()) { assertThat(rows.next()).isTrue(); assertThat(rows.getLong(1)).isEqualTo(1); }
+            }
+        }
+    }
+}
