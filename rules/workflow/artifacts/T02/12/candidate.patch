+package com.papaya.claims.claim.domain.persistence;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.Instant;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+
+class PaymentOutboxIT extends PersistenceITSupport {
+    @Test
+    void runtimePersistsAndConfirmsPaymentRequest() throws Exception {
+        try (var connection = runtime()) {
+            UUID claimId = insertClaim(connection);
+            UUID requestId = UUID.randomUUID();
+            try (var insert = connection.prepareStatement("INSERT INTO payment_requests(id,claim_id,request_id,currency,amount) VALUES(?,?,?,'USD',125.00)")) {
+                insert.setObject(1, UUID.randomUUID()); insert.setObject(2, claimId); insert.setObject(3, requestId);
+                assertThat(insert.executeUpdate()).isEqualTo(1);
+            }
+            try (var exists = connection.prepareStatement("SELECT EXISTS(SELECT 1 FROM payment_requests WHERE claim_id=?)")) {
+                exists.setObject(1, claimId); try (var row = exists.executeQuery()) { assertThat(row.next()).isTrue(); assertThat(row.getBoolean(1)).isTrue(); }
+            }
+            try (var confirm = connection.prepareStatement("UPDATE payment_requests SET status='CONFIRMED',reference=?,confirmed_at=clock_timestamp() WHERE claim_id=? AND status='REQUESTED'")) {
+                confirm.setString(1, "PAY-123"); confirm.setObject(2, claimId); assertThat(confirm.executeUpdate()).isEqualTo(1);
+            }
+            try (var read = connection.prepareStatement("SELECT status,reference,confirmed_at IS NOT NULL FROM payment_requests WHERE claim_id=?")) {
+                read.setObject(1, claimId); try (var row = read.executeQuery()) { assertThat(row.next()).isTrue(); assertThat(row.getString(1)).isEqualTo("CONFIRMED"); assertThat(row.getString(2)).isEqualTo("PAY-123"); assertThat(row.getBoolean(3)).isTrue(); }
+            }
+        }
+    }
+
+    @Test
+    void outboxClaimLeaseRetryAndDeliveryArePersisted() throws Exception {
+        try (var connection = runtime()) {
+            UUID claimId = insertClaim(connection), outboxId = UUID.randomUUID();
+            try (var insert = connection.prepareStatement("INSERT INTO local_outbox(id,claim_id,effect,payload,available_at) VALUES(?,?,'notify', '{\"event\":\"ready\"}'::jsonb, clock_timestamp())")) {
+                insert.setObject(1, outboxId); insert.setObject(2, claimId); assertThat(insert.executeUpdate()).isEqualTo(1);
+            }
+            Instant now = Instant.now();
+            try (var claim = connection.prepareStatement("WITH due AS (SELECT id FROM local_outbox WHERE delivered_at IS NULL AND available_at <= ? ORDER BY available_at,id FOR UPDATE SKIP LOCKED LIMIT 1) UPDATE local_outbox o SET attempts=o.attempts+1,available_at=? + interval '30 seconds' FROM due WHERE o.id=due.id RETURNING o.attempts,o.available_at")) {
+                claim.setTimestamp(1, java.sql.Timestamp.from(now)); claim.setTimestamp(2, java.sql.Timestamp.from(now));
+                try (var row = claim.executeQuery()) { assertThat(row.next()).isTrue(); assertThat(row.getInt(1)).isEqualTo(1); assertThat(row.getTimestamp(2).toInstant()).isAfter(now); }
+            }
+            Instant retryAt = now.plusSeconds(45);
+            try (var failed = connection.prepareStatement("UPDATE local_outbox SET last_error=left(?,240),available_at=? WHERE id=? AND delivered_at IS NULL")) {
+                failed.setString(1, "temporary delivery failure"); failed.setTimestamp(2, java.sql.Timestamp.from(retryAt)); failed.setObject(3, outboxId); assertThat(failed.executeUpdate()).isEqualTo(1);
+            }
+            try (var retryClaim = connection.prepareStatement("WITH due AS (SELECT id FROM local_outbox WHERE delivered_at IS NULL AND available_at <= ? ORDER BY available_at,id FOR UPDATE SKIP LOCKED LIMIT 1) UPDATE local_outbox o SET attempts=o.attempts+1,available_at=? + interval '30 seconds' FROM due WHERE o.id=due.id RETURNING o.attempts")) {
+                retryClaim.setTimestamp(1, java.sql.Timestamp.from(retryAt)); retryClaim.setTimestamp(2, java.sql.Timestamp.from(retryAt));
+                try (var row = retryClaim.executeQuery()) { assertThat(row.next()).isTrue(); assertThat(row.getInt(1)).isEqualTo(2); }
+            }
+            try (var delivered = connection.prepareStatement("UPDATE local_outbox SET delivered_at=? WHERE id=? AND delivered_at IS NULL")) {
+                delivered.setTimestamp(1, java.sql.Timestamp.from(retryAt.plusSeconds(1))); delivered.setObject(2, outboxId); assertThat(delivered.executeUpdate()).isEqualTo(1);
+            }
+            try (var read = connection.prepareStatement("SELECT attempts,last_error,delivered_at IS NOT NULL FROM local_outbox WHERE id=?")) {
+                read.setObject(1, outboxId); try (var row = read.executeQuery()) { assertThat(row.next()).isTrue(); assertThat(row.getInt(1)).isEqualTo(2); assertThat(row.getString(2)).isEqualTo("temporary delivery failure"); assertThat(row.getBoolean(3)).isTrue(); }
+            }
+        }
+    }
+}
