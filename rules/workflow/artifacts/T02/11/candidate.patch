+    <result property="lastInformationRequestedAt" column="last_information_requested_at"/>
+    <result property="lastInformationReceivedAt" column="last_information_received_at"/>
+    <result property="assessmentStartedAt" column="assessment_started_at"/><result property="rejectedAt" column="rejected_at"/>
+    <result property="memberAcknowledgedRejectionAt" column="member_acknowledged_rejection_at"/>
+    <result property="createdAt" column="created_at"/><result property="updatedAt" column="updated_at"/>
+  </resultMap>
+  <sql id="columns">id, member_id, state, policy_limit, currency, version, facts::text AS facts_json,
+    information_requests, last_information_requested_at, last_information_received_at, assessment_started_at,
+    rejected_at, member_acknowledged_rejection_at, created_at, updated_at</sql>
+  <insert id="insert" parameterType="com.papaya.claims.claim.domain.persistence.ClaimRow">
+    INSERT INTO claims(id,member_id,state,policy_limit,currency,version,facts,information_requests,
+      last_information_requested_at,last_information_received_at,assessment_started_at,rejected_at,
+      member_acknowledged_rejection_at,created_at,updated_at)
+    VALUES(#{id},#{memberId},#{state},#{policyLimit},#{currency},#{version},CAST(#{factsJson} AS jsonb),#{informationRequests},
+      #{lastInformationRequestedAt},#{lastInformationReceivedAt},#{assessmentStartedAt},#{rejectedAt},
+      #{memberAcknowledgedRejectionAt},#{createdAt},#{updatedAt})
+  </insert>
+  <select id="find" resultMap="claimRow">SELECT <include refid="columns"/> FROM claims WHERE id=#{id}</select>
+  <select id="findForUpdate" resultMap="claimRow">SELECT <include refid="columns"/> FROM claims WHERE id=#{id} FOR UPDATE</select>
+  <select id="pageAll" resultMap="claimRow">SELECT <include refid="columns"/> FROM claims ORDER BY created_at DESC,id LIMIT #{limit} OFFSET #{offset}</select>
+  <select id="countAll" resultType="long">SELECT count(*) FROM claims</select>
+  <select id="pageMember" resultMap="claimRow">SELECT <include refid="columns"/> FROM claims WHERE member_id=#{memberId} ORDER BY created_at DESC,id LIMIT #{limit} OFFSET #{offset}</select>
+  <select id="countMember" resultType="long">SELECT count(*) FROM claims WHERE member_id=#{memberId}</select>
+  <update id="compareAndSet">
+    UPDATE claims SET member_id=#{row.memberId},state=#{row.state},policy_limit=#{row.policyLimit},currency=#{row.currency},
+      facts=CAST(#{row.factsJson} AS jsonb),information_requests=#{row.informationRequests},
+      last_information_requested_at=#{row.lastInformationRequestedAt},last_information_received_at=#{row.lastInformationReceivedAt},
+      assessment_started_at=#{row.assessmentStartedAt},rejected_at=#{row.rejectedAt},
+      member_acknowledged_rejection_at=#{row.memberAcknowledgedRejectionAt},updated_at=#{row.updatedAt},version=version+1
+    WHERE id=#{row.id} AND version=#{expectedVersion}
+  </update>
+</mapper>
diff --git a/src/main/resources/sql/service/claim/EffectsMapper.xml b/src/main/resources/sql/service/claim/EffectsMapper.xml
new file mode 100644
--- /dev/null
+++ b/src/main/resources/sql/service/claim/EffectsMapper.xml
@@ -0,0 +1,33 @@
+<?xml version="1.0" encoding="UTF-8" ?>
+<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
+<mapper namespace="com.papaya.claims.claim.domain.mapper.EffectsMapper">
+  <resultMap id="outboxRow" type="com.papaya.claims.claim.domain.persistence.OutboxRow">
+    <id property="id" column="id"/><result property="claimId" column="claim_id"/><result property="effect" column="effect"/>
+    <result property="payloadJson" column="payload_json"/><result property="attempts" column="attempts"/>
+    <result property="availableAt" column="available_at"/>
+  </resultMap>
+  <resultMap id="paymentRow" type="com.papaya.claims.claim.domain.persistence.PaymentRow">
+    <id property="claimId" column="claim_id"/><result property="reference" column="reference"/><result property="confirmedAt" column="confirmed_at"/>
+  </resultMap>
+  <insert id="enqueue" parameterType="com.papaya.claims.claim.domain.persistence.OutboxRow">
+    INSERT INTO local_outbox(id,claim_id,effect,payload,attempts,available_at)
+    VALUES(#{id},#{claimId},#{effect},CAST(#{payloadJson} AS jsonb),#{attempts},#{availableAt})
+  </insert>
+  <select id="claimDue" resultMap="outboxRow">
+    WITH due AS (SELECT id FROM local_outbox WHERE delivered_at IS NULL AND available_at &lt;= #{now}
+      ORDER BY available_at,id FOR UPDATE SKIP LOCKED LIMIT #{limit})
+    UPDATE local_outbox o SET attempts=o.attempts+1,available_at=#{now} + interval '30 seconds'
+      FROM due WHERE o.id=due.id
+    RETURNING o.id,o.claim_id,o.effect,o.payload::text AS payload_json,o.attempts,o.available_at
+  </select>
+  <update id="delivered">UPDATE local_outbox SET delivered_at=#{at} WHERE id=#{id} AND delivered_at IS NULL</update>
+  <update id="failed">UPDATE local_outbox SET last_error=left(#{error},240),available_at=#{retry} WHERE id=#{id} AND delivered_at IS NULL</update>
+  <insert id="createPayment" parameterType="com.papaya.claims.claim.domain.persistence.PaymentRow">
+    INSERT INTO payment_requests(id,claim_id,request_id,currency,amount) VALUES(gen_random_uuid(),#{claimId},#{requestId},#{currency},#{amount})
+  </insert>
+  <update id="confirmPayment">UPDATE payment_requests SET status='CONFIRMED',reference=#{reference},confirmed_at=clock_timestamp()
+    WHERE claim_id=#{claimId} AND status='REQUESTED'</update>
+  <select id="paymentExists" resultType="boolean">SELECT EXISTS(SELECT 1 FROM payment_requests WHERE claim_id=#{claimId})</select>
+  <select id="paymentConfirmation" resultMap="paymentRow">SELECT claim_id,reference,confirmed_at FROM payment_requests
+    WHERE claim_id=#{claimId} AND status='CONFIRMED'</select>
+</mapper>
