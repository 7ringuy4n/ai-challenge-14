diff --git a/src/test/java/com/papaya/claims/claim/domain/persistence/ClaimPersistenceIT.java b/src/test/java/com/papaya/claims/claim/domain/persistence/ClaimPersistenceIT.java
new file mode 100644
--- /dev/null
+++ b/src/test/java/com/papaya/claims/claim/domain/persistence/ClaimPersistenceIT.java
@@ -0,0 +1,80 @@
+package com.papaya.claims.claim.domain.persistence;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.papaya.claims.claim.domain.*;
+import java.math.BigDecimal;
+import java.sql.DriverManager;
+import java.sql.Statement;
+import java.time.Instant;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.test.context.DynamicPropertyRegistry;
+import org.springframework.test.context.DynamicPropertySource;
+import org.testcontainers.containers.PostgreSQLContainer;
+import org.testcontainers.junit.jupiter.Container;
+import org.testcontainers.junit.jupiter.Testcontainers;
+
+@Testcontainers(disabledWithoutDocker = true)
+@SpringBootTest
+class ClaimPersistenceIT {
+    @Container static final PostgreSQLContainer<?> POSTGRES = new PostgreSQLContainer<>("postgres:16-alpine");
+    @DynamicPropertySource static void database(DynamicPropertyRegistry properties) {
+        POSTGRES.start();
+        try (var connection=DriverManager.getConnection(POSTGRES.getJdbcUrl(),POSTGRES.getUsername(),POSTGRES.getPassword());
+             Statement statement=connection.createStatement()) {
+            statement.execute("CREATE ROLE claims_runtime LOGIN PASSWORD 'runtime-test'");
+            statement.execute("CREATE ROLE claims_migration LOGIN SUPERUSER PASSWORD 'migration-test'");
+        } catch (Exception e) { throw new IllegalStateException("Could not provision isolated test roles",e); }
+        properties.add("spring.datasource.url",POSTGRES::getJdbcUrl);
+        properties.add("spring.datasource.username",() -> "claims_runtime");
+        properties.add("spring.datasource.password",() -> "runtime-test");
+        properties.add("spring.liquibase.user",() -> "claims_migration");
+        properties.add("spring.liquibase.password",() -> "migration-test");
+    }
+    @Autowired ClaimRepository claims;
+    @Autowired ClaimAuditRepository audits;
+    @Autowired IdempotencyRepository receipts;
+    @Autowired OutboxRepository outbox;
+
+    @Test void storesExactNumbersAppliesMemberFilterAndComparesExpectedVersion() {
+        UUID id=UUID.randomUUID(); Instant now=Instant.now().truncatedTo(java.time.temporal.ChronoUnit.MICROS);
+        Claim claim=new Claim(id,id.toString(),"submitted",new BigDecimal("1234567890123456.78"),"USD",0,
+                new ClaimFacts(Map.of("nested",Map.of("amount",new BigDecimal("0.000000000000000000123456789")))),now,now);
+        ClaimAggregate aggregate=new ClaimAggregate(claim,ClaimWorkflowData.empty()); claims.insert(aggregate);
+        Actor member=new Actor(id.toString(),Set.of("member"),false);
+        var page=claims.listVisible(new PageRequest(0,20),member);
+        assertThat(page.total()).isEqualTo(1); assertThat(page.items()).extracting(a -> a.claim().id()).contains(id);
+        ClaimAggregate loaded=claims.find(id).orElseThrow();
+        assertThat(loaded.claim().policyLimit()).isEqualByComparingTo("1234567890123456.78");
+        assertThat((BigDecimal)((Map<?,?>)loaded.claim().facts().values().get("nested")).get("amount"))
+                .isEqualByComparingTo("0.000000000000000000123456789");
+        assertThat(claims.compareAndSet(loaded,0)).isTrue();
+        assertThat(claims.compareAndSet(loaded,0)).isFalse();
+        assertThat(claims.find(id).orElseThrow().claim().version()).isEqualTo(1);
+        assertThat(claims.listVisible(new PageRequest(0,20),new Actor("member-b",Set.of("member"),false)).total()).isZero();
+    }
+
+    @Test void auditsAreAppendOnlyAndReadInSequenceOrder() {
+        UUID claimId=UUID.randomUUID();
+        for (long sequence : new long[]{2,1}) audits.append(new AuditRecord(UUID.randomUUID(),claimId,sequence,
+                Instant.now(),"new","review","worker","adjuster","reason","corr","v1"));
+        var result=audits.findByClaim(claimId,new PageRequest(0,10));
+        assertThat(result.total()).isEqualTo(2); assertThat(result.items()).extracting(AuditRecord::sequence).containsExactly(1L,2L);
+    }
+
+    @Test void persistsReceiptReplayDataAndOutboxClaimLease() {
+        UUID receiptId=UUID.randomUUID(); var receipt=new IdempotencyRepository.Receipt(receiptId,"actor","claim:create","key-1","a".repeat(64),"{\"claimId\":\"abc\"}");
+        receipts.insert(receipt);
+        assertThat(receipts.find("actor","claim:create","key-1").orElseThrow().resultJson()).isEqualTo(receipt.resultJson());
+        UUID messageId=UUID.randomUUID(); Instant now=Instant.now().plusSeconds(1);
+        outbox.enqueue(new OutboxRepository.Message(messageId,null,"notify","{}",0,now.minusSeconds(1)));
+        var claimed=outbox.claimDue(now,10);
+        assertThat(claimed).extracting(OutboxRepository.Message::id).contains(messageId);
+        assertThat(outbox.markDelivered(messageId,Instant.now())).isTrue();
+    }
+}
