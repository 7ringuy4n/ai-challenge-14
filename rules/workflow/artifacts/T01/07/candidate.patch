@@ -0,0 +1,17 @@
+package com.papaya.claims.workflow;
+
+import java.util.List;
+
+public final class WorkflowEngine {
+    private final WorkflowDefinition definition; private final GuardEvaluator guards;
+    public WorkflowEngine(WorkflowDefinition definition, GuardEvaluator guards) { this.definition=definition; this.guards=guards; }
+    public List<WorkflowOption> available(WorkflowEvaluationContext c) { return definition.transitions().stream().filter(t->t.from().equals(c.claim().state())).map(t->new WorkflowOption(t.id(),t.from(),t.to(),t.effects())).toList(); }
+    public WorkflowDecision evaluate(WorkflowEvaluationContext c) {
+        List<WorkflowOption> opts=available(c); WorkflowDefinition.Transition t=definition.transitions().stream().filter(x->x.from().equals(c.claim().state())&&x.to().equals(c.command().targetState())).findFirst().orElse(null);
+        if(t==null) return WorkflowDecision.denied("INVALID_EDGE","No transition exists from current state to requested state",opts);
+        if(!t.roles().stream().anyMatch(c.actor()::hasRole)) return WorkflowDecision.denied("ROLE_FORBIDDEN","Actor is not authorized for this transition",opts);
+        for(String g:t.guards()) if(!guards.passes(g,c)) return WorkflowDecision.denied("GUARD_FAILED",definition.guardMessages().get(g),opts);
+        if(t.id().equals("request-information") && c.evidence().informationCycleCount()>=definition.cycleLimit()) return WorkflowDecision.denied("CYCLE_LIMIT",definition.cycleFailureMessage(),opts);
+        return new WorkflowDecision(true,t.id(),t.from(),t.to(),null,null,t.effects(),opts);
+    }
+}
