@@ -0,0 +1,17 @@
+package com.papaya.claims.workflow;
+
+import java.time.Instant;
+
+/** Trusted server supplied evidence. Never construct this record from client supplied facts. */
+public record WorkflowEvidence(int informationCycleCount, Instant informationRequestedAt,
+        Instant informationReceivedAt, Instant paymentRequestCreatedAt, Instant paymentConfirmedAt,
+        String paymentReference, Instant rejectionAt, Instant memberAcknowledgedAt) {
+    public WorkflowEvidence {
+        informationRequestedAt = micros(informationRequestedAt); informationReceivedAt = micros(informationReceivedAt);
+        paymentRequestCreatedAt = micros(paymentRequestCreatedAt); paymentConfirmedAt = micros(paymentConfirmedAt);
+        rejectionAt = micros(rejectionAt); memberAcknowledgedAt = micros(memberAcknowledgedAt);
+        if (informationCycleCount < 0) throw new IllegalArgumentException("Cycle count cannot be negative");
+    }
+    private static Instant micros(Instant value) { return value == null ? null : value.truncatedTo(java.time.temporal.ChronoUnit.MICROS); }
+    public static WorkflowEvidence empty() { return new WorkflowEvidence(0,null,null,null,null,null,null,null); }
+}
