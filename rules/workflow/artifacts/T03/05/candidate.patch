diff --git a/docker/initdb/10-runtime-role.sh b/docker/initdb/10-runtime-role.sh
new file mode 100755
index 0000000..1111111
--- /dev/null
+++ b/docker/initdb/10-runtime-role.sh
@@ -0,0 +1,16 @@
+#!/bin/sh
+set -eu
+
+# The official image runs init scripts only on first database creation.
+# psql variable quoting safely handles generated passwords without logging them.
+psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" \
+  --set=runtime_user="$CLAIMS_RUNTIME_DB_USER" \
+  --set=runtime_password="$CLAIMS_RUNTIME_DB_PASSWORD" <<'SQL'
+SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', :'runtime_user', :'runtime_password')
+\gexec
+ALTER DEFAULT PRIVILEGES FOR ROLE claims_migration IN SCHEMA public
+  GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO claims_runtime;
+ALTER DEFAULT PRIVILEGES FOR ROLE claims_migration IN SCHEMA public
+  GRANT USAGE, SELECT, UPDATE ON SEQUENCES TO claims_runtime;
+SQL
+
