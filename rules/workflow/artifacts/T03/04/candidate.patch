--- a/docker/Dockerfile
+++ b/docker/Dockerfile
@@ -1,12 +1,15 @@
+# syntax=docker/dockerfile:1.7
 # Build the executable jar with the pinned Java 21/Maven toolchain. Setup builds
 # the image but does not execute the test suite; tests remain an explicit gate.
 FROM maven:3.9.11-eclipse-temurin-21 AS build
 WORKDIR /workspace
 COPY pom.xml ./
+COPY docker/maven-settings.xml ./maven-settings.xml
 COPY src/ src/
 COPY sql/ sql/
 COPY config/ config/
-RUN mvn -B -DskipTests package
+RUN --mount=type=cache,target=/root/.m2 \
+    mvn -s /workspace/maven-settings.xml -B -ntp -DskipTests package
 
 # Keep the runtime image small and run the application without root privileges.
 FROM eclipse-temurin:21-jre-jammy AS runtime
--- /dev/null
