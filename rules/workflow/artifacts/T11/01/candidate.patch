+++ b/src/test/java/com/papaya/claims/engine/ValidationControlFlowTest.java
@@ -0,0 +1,47 @@
+package com.papaya.claims.engine;
+
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class ValidationControlFlowTest {
+    @TempDir Path temp;
+
+    private void rejects(String yaml, String expected) throws Exception {
+        Path file = temp.resolve("workflow.yml");
+        Files.writeString(file, yaml);
+        assertThatThrownBy(() -> WorkflowLoader.load(file))
+                .isInstanceOf(IllegalArgumentException.class).hasMessageContaining(expected);
+    }
+
+    private String base(String roles, String transitions) {
+        return "version: 'test'\ninitialState: A\nstates: [A, B]\nroles: " + roles
+                + "\nmaxInformationRequests: 3\ntransitions:\n" + transitions;
+    }
+    private String edge(String guard) {
+        return "  - from: A\n    to: B\n    role: clerk\n    guards:\n" + guard + "    effects: []\n";
+    }
+
+    @Test void rejectsNullAndDuplicateRoleEntriesAndMissingTransitionCollection() throws Exception {
+        rejects(base("[null]", edge("      - type: present\n        field: x\n")), "must name a configured role");
+        rejects(base("[clerk, clerk]", edge("      - type: present\n        field: x\n")), "must contain unique roles");
+        rejects("version: test\ninitialState: A\nstates: [A]\nroles: [clerk]\ntransitions: null\n", "transitions is required");
+    }
+
+    @Test void rejectsNullTransitionAndNullGuardEntries() throws Exception {
+        rejects(base("[clerk]", "  - null\n"), "transitions[0] must not be null");
+        rejects(base("[clerk]", "  - from: A\n    to: B\n    role: clerk\n    guards:\n      - null\n"), "unknown guard type");
+    }
+
+    @Test void rejectsMissingEqualFieldAndAcceptsLiteralOrOtherFieldOperands() throws Exception {
+        rejects(base("[clerk]", edge("      - type: equal\n        value: yes\n")), "field is required for equal");
+        rejects(base("[clerk]", edge("      - type: equal\n        field: left\n")), "equal requires value or otherField");
+        String validLiteral = base("[clerk]", edge("      - type: equal\n        field: left\n        value: yes\n"));
+        Path file = temp.resolve("valid.yml"); Files.writeString(file, validLiteral);
+        WorkflowLoader.load(file);
+        String validOtherField = base("[clerk]", edge("      - type: equal\n        field: left\n        otherField: right\n"));
+        Files.writeString(file, validOtherField); WorkflowLoader.load(file);
+    }
+}
