+++ b/src/main/java/com/papaya/claims/web/GlobalExceptionHandler.java
@@ -0,0 +1,40 @@
+package com.papaya.claims.web;
+
+import com.papaya.claims.contract.BusinessException;
+import com.papaya.claims.observability.TraceContextFilter;
+import jakarta.servlet.http.HttpServletRequest;
+import java.util.Map;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.converter.HttpMessageNotReadableException;
+import org.springframework.validation.FieldError;
+import org.springframework.web.bind.MethodArgumentNotValidException;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.RestControllerAdvice;
+import org.springframework.web.method.annotation.MethodArgumentTypeMismatchException;
+import org.springframework.web.servlet.NoHandlerFoundException;
+
+@RestControllerAdvice
+public class GlobalExceptionHandler {
+    @ExceptionHandler(BusinessException.class)
+    public org.springframework.http.ResponseEntity<ErrorEnvelope> business(BusinessException error, HttpServletRequest request) {
+        return response(error.status(), error.code(), error.getMessage(), request);
+    }
+    @ExceptionHandler({HttpMessageNotReadableException.class, MethodArgumentTypeMismatchException.class, MethodArgumentNotValidException.class})
+    public org.springframework.http.ResponseEntity<ErrorEnvelope> badRequest(Exception error, HttpServletRequest request) {
+        String message = "Request body or path parameter is invalid";
+        if (error instanceof MethodArgumentNotValidException invalid) {
+            FieldError field = invalid.getBindingResult().getFieldErrors().stream().findFirst().orElse(null);
+            if (field != null) message = "Invalid value for " + field.getField();
+        }
+        return response(400, "INVALID_REQUEST", message, request);
+    }
+    @ExceptionHandler(Exception.class)
+    public org.springframework.http.ResponseEntity<ErrorEnvelope> unexpected(Exception error, HttpServletRequest request) {
+        return response(500, "INTERNAL_ERROR", "The request could not be completed", request);
+    }
+    public static org.springframework.http.ResponseEntity<ErrorEnvelope> response(int status, String code, String message, HttpServletRequest request) {
+        Object trace = request.getAttribute(TraceContextFilter.TRACE_ID_ATTRIBUTE);
+        return org.springframework.http.ResponseEntity.status(status).body(new ErrorEnvelope(code, message,
+                trace instanceof String value ? value : "unavailable", Map.of()));
+    }
+}
diff --git a/src/main/java/com/papaya/claims/web/JsonRequestSizeFilter.java b/src/main/java/com/papaya/claims/web/JsonRequestSizeFilter.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/com/papaya/claims/web/JsonRequestSizeFilter.java
@@ -0,0 +1,56 @@
+package com.papaya.claims.web;
+
+import jakarta.servlet.FilterChain;
+import jakarta.servlet.ServletException;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletRequestWrapper;
+import jakarta.servlet.http.HttpServletResponse;
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.util.Locale;
+import org.springframework.core.Ordered;
+import org.springframework.core.annotation.Order;
+import org.springframework.http.MediaType;
+import org.springframework.stereotype.Component;
+import org.springframework.web.filter.OncePerRequestFilter;
+
+/** Buffers only API JSON bodies and enforces the same limit for fixed and chunked requests. */
+@Component
+@Order(Ordered.HIGHEST_PRECEDENCE + 30)
+public final class JsonRequestSizeFilter extends OncePerRequestFilter {
+    public static final int MAX_BYTES = 64 * 1024;
+    @Override protected void doFilterInternal(HttpServletRequest request, HttpServletResponse response, FilterChain chain) throws ServletException, IOException {
+        String contentType = request.getContentType();
+        if (!request.getRequestURI().startsWith("/api/") || contentType == null || !contentType.toLowerCase(Locale.ROOT).startsWith(MediaType.APPLICATION_JSON_VALUE)) {
+            chain.doFilter(request, response); return;
+        }
+        byte[] body = request.getInputStream().readNBytes(MAX_BYTES + 1);
+        if (body.length > MAX_BYTES) {
+            response.setStatus(400); response.setContentType(MediaType.APPLICATION_JSON_VALUE);
+            new com.fasterxml.jackson.databind.ObjectMapper().writeValue(response.getOutputStream(),
+                    new ErrorEnvelope("REQUEST_TOO_LARGE", "JSON request body exceeds 64 KiB", trace(request), java.util.Map.of()));
+            return;
+        }
+        chain.doFilter(new BufferedRequest(request, body), response);
+    }
+    private static String trace(HttpServletRequest request) {
+        Object value = request.getAttribute(com.papaya.claims.observability.TraceContextFilter.TRACE_ID_ATTRIBUTE);
+        return value instanceof String text ? text : "unavailable";
+    }
+    private static final class BufferedRequest extends HttpServletRequestWrapper {
+        private final byte[] body;
+        BufferedRequest(HttpServletRequest request, byte[] body) { super(request); this.body = body; }
+        @Override public int getContentLength() { return body.length; }
+        @Override public long getContentLengthLong() { return body.length; }
+        @Override public jakarta.servlet.ServletInputStream getInputStream() {
+            ByteArrayInputStream input = new ByteArrayInputStream(body);
+            return new jakarta.servlet.ServletInputStream() {
+                @Override public int read() { return input.read(); }
+                @Override public boolean isFinished() { return input.available() == 0; }
+                @Override public boolean isReady() { return true; }
+                @Override public void setReadListener(jakarta.servlet.ReadListener listener) { throw new UnsupportedOperationException(); }
+            };
+        }
+        @Override public java.io.BufferedReader getReader() { return new java.io.BufferedReader(new java.io.InputStreamReader(getInputStream(), getCharacterEncoding() == null ? java.nio.charset.StandardCharsets.UTF_8 : java.nio.charset.Charset.forName(getCharacterEncoding()))); }
+    }
+}
diff --git a/src/main/java/com/papaya/claims/web/StrictJsonConfiguration.java b/src/main/java/com/papaya/claims/web/StrictJsonConfiguration.java
