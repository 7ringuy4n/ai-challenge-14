diff --git a/src/test/java/com/papaya/claims/contract/ModelBoundaryTest.java b/src/test/java/com/papaya/claims/contract/ModelBoundaryTest.java
--- a/src/test/java/com/papaya/claims/contract/ModelBoundaryTest.java
+++ b/src/test/java/com/papaya/claims/contract/ModelBoundaryTest.java
@@ -64,11 +64,24 @@ class ModelBoundaryTest {
 
         Map<?, ?> frozenNested = (Map<?, ?>) snapshot.facts().get("nested");
         List<?> frozenValues = (List<?>) frozenNested.get("values");
-        assertThat(frozenValues).containsExactly(new BigInteger("9000000000000000000"), new BigDecimal("1.2300"));
+        assertThat(frozenValues).isEqualTo(List.of(
