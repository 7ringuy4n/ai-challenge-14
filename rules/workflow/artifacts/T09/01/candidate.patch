@@ -0,0 +1,87 @@
+package com.papaya.claims.engine;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.stream.IntStream;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class WorkflowValidationTest {
+    @TempDir Path temp;
+
+    private Path write(String name, String yaml) throws Exception {
+        Path path = temp.resolve(name);
+        Files.writeString(path, yaml);
+        return path;
+    }
+
+    private String valid() {
+        return "version: 'test'\ninitialState: A\nstates: [A, B]\nroles: [clerk]\n"
+                + "maxInformationRequests: 3\ntransitions:\n"
+                + "  - from: A\n    to: B\n    role: clerk\n    guards: []\n    effects: []\n";
+    }
+
+    private String transition(String extra) {
+        return valid().replace("    guards: []\n    effects: []\n", extra + "\n    effects: []\n");
+    }
+
+    private void rejects(String name, String yaml, String diagnostic) throws Exception {
+        var error = org.junit.jupiter.api.Assertions.assertThrows(IllegalArgumentException.class,
+                () -> WorkflowLoader.load(write(name, yaml)));
+        assertThat(error.getMessage()).contains(name, diagnostic);
+    }
+
+    @Test
+    void rejectsUnknownFieldsMalformedYamlAndEmptyDocuments() throws Exception {
+        rejects("unknown.yml", valid() + "surprise: true\n", "Unrecognized field");
+        rejects("malformed.yml", "version: [\n", "invalid workflow configuration");
+        rejects("empty.yml", "", "document is empty");
+    }
+
+    @Test
+    void rejectsBlankRequiredFieldsAndEmptyStateCollections() throws Exception {
+        rejects("blank-version.yml", valid().replace("version: 'test'", "version: '  '"), "version is required");
+        rejects("blank-edge.yml", valid().replace("    from: A", "    from: '  '"), "transitions[0].from is required");
+        rejects("empty-states.yml", valid().replace("states: [A, B]", "states: []"), "states must contain at least one state");
+    }
+
+    @Test
+    void rejectsDuplicateStatesAndDuplicateEdges() throws Exception {
+        rejects("duplicate-states.yml", valid().replace("states: [A, B]", "states: [A, A]"), "contains duplicate state");
+        String duplicateEdge = valid() + "  - from: A\n    to: B\n    role: clerk\n    guards: []\n    effects: []\n";
+        rejects("duplicate-edge.yml", duplicateEdge, "duplicate from/to edge");
+    }
+
+    @Test
+    void rejectsDanglingStateNegativeCounterUnknownRoleAndTimer() throws Exception {
+        rejects("dangling.yml", valid().replace("    to: B", "    to: C"), "from/to must name configured states");
+        rejects("negative-count.yml", valid().replace("maxInformationRequests: 3", "maxInformationRequests: -1"), "maxInformationRequests must be nonnegative");
+        rejects("unknown-role.yml", valid().replace("    role: clerk", "    role: guest"), "must name a configured role");
+        rejects("timer.yml", valid().replace("    effects: []", "    effects: []\n    timerAction: LATER"), "must be NONE, START, or RESET");
+    }
+
+    @Test
+    void rejectsEmptyAnyAndMissingGuardFieldsOrOperands() throws Exception {
+        rejects("empty-any.yml", transition("    guards:\n      - type: any\n        guards: []"), "any requires child guards");
+        rejects("missing-field.yml", transition("    guards:\n      - type: present"), "field is required for present");
+        rejects("missing-operand.yml", transition("    guards:\n      - type: equal\n        field: left"), "equal requires value or otherField");
+        rejects("missing-number-operand.yml", transition("    guards:\n      - type: lessOrEqual\n        field: amount"), "requires value or otherField");
+    }
+
+    @Test
+    void rejectsGuardNestingBeyondConfiguredMaximum() throws Exception {
+        String guard = "      - type: isTrue\n        field: ready\n";
+        for (int level = 0; level < 13; level++) {
+            guard = "      - type: any\n        guards:\n" + indent(guard, 4);
+        }
+        rejects("deep-guards.yml", transition("    guards:\n" + guard.stripTrailing()), "guard nesting exceeds 12");
+    }
+
+    private String indent(String text, int spaces) {
+        String prefix = " ".repeat(spaces);
+        return text.lines().map(line -> prefix + line).reduce((left, right) -> left + "\n" + right).orElse("");
+    }
+}
