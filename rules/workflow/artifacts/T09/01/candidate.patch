+package com.papaya.claims.persistence;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import com.fasterxml.jackson.core.JsonProcessingException;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.sql.CallableStatement;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.util.UUID;
+import org.apache.ibatis.type.JdbcType;
+import org.junit.jupiter.api.Test;
+
+class PersistenceBoundaryTest {
+    @Test
+    void uuidHandlerReadsNativeUuidTextAndNullAcrossAllResultOverloads() throws Exception {
+        UuidTypeHandler handler = new UuidTypeHandler();
+        UUID expected = UUID.randomUUID();
+        ResultSet resultSet = mock(ResultSet.class);
+        when(resultSet.getObject("id")).thenReturn(expected);
+        when(resultSet.getObject(1)).thenReturn(expected.toString());
+        CallableStatement callable = mock(CallableStatement.class);
+        when(callable.getObject(1)).thenReturn(expected);
+
+        assertThat(handler.getNullableResult(resultSet, "id")).isEqualTo(expected);
+        assertThat(handler.getNullableResult(resultSet, 1)).isEqualTo(expected);
+        assertThat(handler.getNullableResult(callable, 1)).isEqualTo(expected);
+
+        when(resultSet.getObject("missing")).thenReturn(null);
+        assertThat(handler.getNullableResult(resultSet, "missing")).isNull();
+    }
+
+    @Test
+    void uuidHandlerRejectsMalformedDatabaseTextAndBindsUuidAsPostgresOther() throws Exception {
+        UuidTypeHandler handler = new UuidTypeHandler();
+        ResultSet resultSet = mock(ResultSet.class);
+        when(resultSet.getObject("id")).thenReturn("not-a-uuid");
+        assertThatThrownBy(() -> handler.getNullableResult(resultSet, "id"))
+                .isInstanceOf(IllegalArgumentException.class);
+
+        PreparedStatement statement = mock(PreparedStatement.class);
+        UUID value = UUID.randomUUID();
+        handler.setNonNullParameter(statement, 4, value, JdbcType.OTHER);
+        org.mockito.Mockito.verify(statement).setObject(4, value, java.sql.Types.OTHER);
+    }
+
+    @Test
+    void jsonAdaptersWrapEncodeDecodeAndReceiptFailuresWithStableContext() {
+        ObjectMapper failingWriter = mock(ObjectMapper.class);
+        try {
+            when(failingWriter.writeValueAsString(org.mockito.ArgumentMatchers.any()))
+                    .thenThrow(new JsonProcessingException("forced serialization failure") {});
+        } catch (JsonProcessingException impossible) {
+            throw new AssertionError(impossible);
+        }
+        assertThatThrownBy(() -> PersistenceJson.write(failingWriter, java.util.Map.of("x", 1)))
+                .isInstanceOf(IllegalStateException.class).hasMessage("Unable to encode persistence JSON");
+
+        ObjectMapper mapper = new ObjectMapper();
+        assertThatThrownBy(() -> PersistenceJson.readMap(mapper, "{"))
+                .isInstanceOf(IllegalStateException.class).hasMessage("Unable to decode persistence JSON");
+        assertThatThrownBy(() -> PersistenceJson.receipt(mapper, "{"))
+                .isInstanceOf(IllegalStateException.class).hasMessage("Unable to decode command receipt");
+    }
+}
