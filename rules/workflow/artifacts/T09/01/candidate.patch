+package com.papaya.claims.persistence;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.papaya.claims.contract.Model.ClaimSnapshot;
+import com.papaya.claims.contract.Model.OutboxMessage;
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.testcontainers.containers.PostgreSQLContainer;
+import org.testcontainers.junit.jupiter.Container;
+import org.testcontainers.junit.jupiter.Testcontainers;
+
+@Testcontainers(disabledWithoutDocker = false)
+class PersistenceBoundaryIT {
+    @Container
+    static final PostgreSQLContainer<?> postgres = new PostgreSQLContainer<>("postgres:16-alpine")
+            .withDatabaseName("claims")
+            .withUsername("postgres")
+            .withPassword("integration-test-password");
+
+    private static PostgresPersistenceSupport.Harness harness;
+
+    @BeforeAll
+    static void setUp() throws Exception {
+        harness = PostgresPersistenceSupport.start(postgres);
+    }
+
+    @Test
+    void emptyAndPopulatedClaimListsAbsentReceiptAndDeliveredOutboxAreReadFromPostgres() {
+        assertThat(harness.claims().list()).isEmpty();
+
+        ClaimSnapshot first = claim("member-1");
+        ClaimSnapshot second = claim("member-2");
+        harness.claims().insert(first);
+        harness.claims().insert(second);
+
+        assertThat(harness.claims().list()).containsExactlyInAnyOrder(first, second);
+        assertThat(harness.commands().find(first.id(), "clerk", "absent-key")).isEmpty();
+
+        UUID outboxId = UUID.randomUUID();
+        OutboxMessage message = new OutboxMessage(outboxId, first.id(), "notify_approval", "{\"ok\":true}", 0);
+        harness.effects().enqueue(List.of(message));
+        assertThat(harness.effects().pending()).contains(message);
+        harness.effects().markDelivered(outboxId);
+        assertThat(harness.effects().pending()).doesNotContain(message);
+    }
+
+    private ClaimSnapshot claim(String memberId) {
+        return new ClaimSnapshot(UUID.randomUUID(), memberId, "RECEIVED", new BigDecimal("25.00"),
+                "USD", Map.of("source", "boundary"), 0, 0, null, null);
+    }
+}
