@@ -0,0 +1,60 @@
+package com.papaya.claims.engine;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+
+class DefinitionImmutabilityTest {
+    @Test
+    void configurationCollectionsAndNestedGuardValuesAreDefensiveCopies() {
+        var nestedMap = new LinkedHashMap<String, Object>();
+        var nestedItems = new ArrayList<Object>(List.of("invoice"));
+        nestedMap.put("required", nestedItems);
+        var rawValue = new ArrayList<Object>();
+        rawValue.add(nestedMap);
+        var children = new ArrayList<WorkflowDefinition.Guard>();
+        children.add(new WorkflowDefinition.Guard("present", "assessorId", null, null, List.of(), null));
+        var guards = new ArrayList<>(children);
+        var effects = new ArrayList<>(List.of("notify_assessors"));
+        var clears = new ArrayList<>(List.of("reportComplete"));
+        var transition = new WorkflowDefinition.Transition("A", "B", "clerk", guards, effects,
+                false, WorkflowDefinition.TimerAction.NONE, clears);
+        var transitions = new ArrayList<>(List.of(transition));
+        var states = new ArrayList<>(List.of("A", "B"));
+        var roles = new ArrayList<>(List.of("clerk"));
+        var definition = new WorkflowDefinition("v1", "A", states, roles, 3, transitions);
+        var guard = new WorkflowDefinition.Guard("equal", "actual", null, rawValue, children, "must match");
+
+        nestedItems.add("tampered");
+        nestedMap.put("extra", true);
+        rawValue.add("later");
+        children.clear();
+        guards.clear();
+        effects.clear();
+        clears.clear();
+        transitions.clear();
+        states.add("C");
+        roles.clear();
+
+        assertThat(definition.states()).containsExactly("A", "B");
+        assertThat(definition.roles()).containsExactly("clerk");
+        assertThat(definition.transitions()).containsExactly(transition);
+        assertThat(transition.guards()).hasSize(1);
+        assertThat(transition.effects()).containsExactly("notify_assessors");
+        assertThat(transition.clearFacts()).containsExactly("reportComplete");
+        assertThat((List<?>) ((Map<?, ?>) ((List<?>) guard.value()).get(0)).get("required"))
+                .containsExactly("invoice");
+        assertThat(guard.guards()).hasSize(1);
+        assertThatThrownBy(() -> ((List<Object>) ((Map<?, ?>) ((List<?>) guard.value()).get(0)).get("required")).add("x"))
+                .isInstanceOf(UnsupportedOperationException.class);
+        assertThatThrownBy(() -> ((List<Object>) guard.value()).add("x"))
+                .isInstanceOf(UnsupportedOperationException.class);
+        assertThatThrownBy(() -> ((List<WorkflowDefinition.Guard>) transition.guards()).clear())
+                .isInstanceOf(UnsupportedOperationException.class);
+    }
+}
