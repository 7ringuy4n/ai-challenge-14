+package com.papaya.claims.contract;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import com.papaya.claims.contract.Model.Actor;
+import com.papaya.claims.contract.Model.ClaimSnapshot;
+import com.papaya.claims.contract.Model.Decision;
+import com.papaya.claims.contract.Model.TransitionCommand;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+
+class ModelBoundaryTest {
+    private static ClaimSnapshot claim(BigDecimal limit, int requests, long version, Map<String, Object> facts) {
+        return new ClaimSnapshot(UUID.randomUUID(), "member-1", "UNDER_ASSESSMENT", limit,
+                "USD", facts, requests, version, null, null);
+    }
+
+    @Test
+    void rejectsCurrencyScaleAndNegativeCountersAtConstructionBoundary() {
+        assertThatThrownBy(() -> claim(new BigDecimal("1.001"), 0, 0, Map.of()))
+                .isInstanceOf(BusinessException.class).extracting("code").isEqualTo("INVALID_AMOUNT");
+        assertThatThrownBy(() -> claim(BigDecimal.ONE, -1, 0, Map.of()))
+                .isInstanceOf(BusinessException.class).extracting("code").isEqualTo("INVALID_VERSION");
+        assertThatThrownBy(() -> claim(BigDecimal.ONE, 0, -1, Map.of()))
+                .isInstanceOf(BusinessException.class).extracting("code").isEqualTo("INVALID_VERSION");
+        assertThatThrownBy(() -> new ClaimSnapshot(UUID.randomUUID(), "member", "RECEIVED",
+                BigDecimal.ONE, "usd", Map.of(), 0, 0, null, null))
+                .isInstanceOf(BusinessException.class).extracting("code").isEqualTo("INVALID_CURRENCY");
+    }
+
+    @Test
+    void enforcesCommandLengthsAndNonnegativeExpectedVersion() {
+        assertThatThrownBy(() -> new TransitionCommand("A".repeat(81), 0, "key", ""))
+                .isInstanceOf(BusinessException.class).extracting("code").isEqualTo("INVALID_COMMAND");
+        assertThatThrownBy(() -> new TransitionCommand("APPROVED", 0, "k".repeat(121), ""))
+                .isInstanceOf(BusinessException.class).extracting("code").isEqualTo("INVALID_COMMAND");
+        assertThatThrownBy(() -> new TransitionCommand("APPROVED", -1, "key", ""))
+                .isInstanceOf(BusinessException.class).extracting("code").isEqualTo("INVALID_COMMAND");
+        assertThatThrownBy(() -> new TransitionCommand("APPROVED", 0, "key", "n".repeat(2001)))
+                .isInstanceOf(BusinessException.class).extracting("code").isEqualTo("INVALID_COMMAND");
+    }
+
+    @Test
+    void rejectsBlankFactKeysAndFreezesNestedMapAndListCopies() {
+        assertThatThrownBy(() -> Model.freezeMap(Map.of(" \t", true)))
+                .isInstanceOf(BusinessException.class).extracting("code").isEqualTo("INVALID_INPUT");
+
+        var nested = new LinkedHashMap<String, Object>();
+        var values = new ArrayList<Object>(List.of(new BigInteger("9000000000000000000"), new BigDecimal("1.2300")));
+        nested.put("values", values);
+        var source = new LinkedHashMap<String, Object>();
+        source.put("nested", nested);
+        ClaimSnapshot snapshot = claim(BigDecimal.TEN, 0, 0, source);
+        values.set(0, 2);
+        nested.put("later", true);
+        source.put("new", "fact");
+
+        Map<?, ?> frozenNested = (Map<?, ?>) snapshot.facts().get("nested");
+        List<?> frozenValues = (List<?>) frozenNested.get("values");
+        assertThat(frozenValues).containsExactly(new BigInteger("9000000000000000000"), new BigDecimal("1.2300"));
+        assertThat(frozenNested).doesNotContainKey("later");
+        assertThat(snapshot.facts()).doesNotContainKey("new");
+        assertThatThrownBy(() -> frozenNested.put("x", true)).isInstanceOf(UnsupportedOperationException.class);
+        assertThatThrownBy(() -> ((List<Object>) frozenValues).add(false)).isInstanceOf(UnsupportedOperationException.class);
+    }
+
+    @Test
+    void transitionClearsOnlyNamedFactsAndAdvancesSnapshotVersion() {
+        ClaimSnapshot original = claim(BigDecimal.TEN, 1, 7,
+                Map.of("reportComplete", true, "amount", new BigDecimal("3.50"), "keep", "value"));
+        Instant started = Instant.parse("2026-10-16T12:00:00.123456789Z");
+        Decision decision = new Decision("UNDER_ASSESSMENT", "PENDING_INFO", 2, started,
+                started, List.of("request_information"), List.of("reportComplete", "amount"));
+
+        ClaimSnapshot transitioned = original.transition(decision);
+
+        assertThat(transitioned.state()).isEqualTo("PENDING_INFO");
+        assertThat(transitioned.version()).isEqualTo(8);
+        assertThat(transitioned.informationRequests()).isEqualTo(2);
+        assertThat(transitioned.facts()).containsOnlyKeys("keep").containsEntry("keep", "value");
+        assertThat(transitioned.assessmentStartedAt()).isEqualTo(Instant.parse("2026-10-16T12:00:00.123456Z"));
+        assertThat(transitioned.lastInformationRequestedAt()).isEqualTo(transitioned.assessmentStartedAt());
+        assertThat(original.facts()).containsKeys("reportComplete", "amount", "keep");
+    }
+}
