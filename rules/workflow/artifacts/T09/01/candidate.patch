@@ -0,0 +1,86 @@
+package com.papaya.claims.engine;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.papaya.claims.contract.Model.ClaimSnapshot;
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+
+class GuardBoundaryTest {
+    private final GuardEvaluator evaluator = new GuardEvaluator();
+
+    private ClaimSnapshot claim(Map<String, Object> facts) {
+        return new ClaimSnapshot(UUID.randomUUID(), "member-1", "UNDER_ASSESSMENT",
+                new BigDecimal("100.00"), "USD", facts, 0, 0, null, null);
+    }
+
+    private WorkflowDefinition.Guard guard(String type, String field, String otherField, Object value) {
+        return new WorkflowDefinition.Guard(type, field, otherField, value, List.of(), null);
+    }
+
+    private boolean passes(WorkflowDefinition.Guard guard, Map<String, Object> facts) {
+        return evaluator.failures(List.of(guard), claim(facts), Instant.parse("2026-10-16T00:00:00Z")).isEmpty();
+    }
+
+    @Test
+    void presentRejectsBlankStringsAndEmptyCollectionsButAcceptsNonemptyValues() {
+        assertThat(passes(guard("present", "text", null, null), Map.of("text", " \t"))).isFalse();
+        assertThat(passes(guard("present", "items", null, null), Map.of("items", List.of()))).isFalse();
+        assertThat(passes(guard("present", "items", null, null), Map.of("items", List.of("document")))).isTrue();
+        assertThat(passes(guard("present", "count", null, null), Map.of("count", 0))).isTrue();
+    }
+
+    @Test
+    void isTrueAcceptsOnlyBooleanTrue() {
+        assertThat(passes(guard("isTrue", "flag", null, null), Map.of("flag", false))).isFalse();
+        assertThat(passes(guard("isTrue", "flag", null, null), Map.of("flag", "true"))).isFalse();
+        assertThat(passes(guard("isTrue", "flag", null, null), Map.of("flag", 1))).isFalse();
+        assertThat(passes(guard("isTrue", "flag", null, null), Map.of("flag", true))).isTrue();
+    }
+
+    @Test
+    void numericEqualityUsesValueAcrossJsonNumberRepresentations() {
+        assertThat(passes(guard("equal", "left", null, new BigDecimal("12.500")),
+                Map.of("left", 12.5d))).isTrue();
+        assertThat(passes(guard("equal", "left", "right", null),
+                Map.of("left", 12, "right", new BigDecimal("12.01")))).isFalse();
+        assertThat(passes(guard("equal", "left", "right", null),
+                Map.of("left", "not-a-number", "right", 12))).isFalse();
+    }
+
+    @Test
+    void documentGuardFailsClosedForEmptyRequiredListAndMissingDocumentMap() {
+        var documents = guard("allDocumentsValid", "requiredDocuments", null, null);
+        assertThat(passes(documents, Map.of("requiredDocuments", List.of(), "documents", Map.of()))).isFalse();
+        assertThat(passes(documents, Map.of("requiredDocuments", List.of("invoice")))).isFalse();
+        assertThat(passes(documents, Map.of("requiredDocuments", List.of("invoice"),
+                "documents", Map.of("invoice", true)))).isTrue();
+    }
+
+    @Test
+    void anyWithoutSatisfiedChildrenFailsClosed() {
+        var any = new WorkflowDefinition.Guard("any", null, null, null,
+                List.of(guard("isTrue", "acknowledged", null, null), guard("present", "reason", null, null)), null);
+        assertThat(evaluator.failures(List.of(any), claim(Map.of()), Instant.EPOCH)).hasSize(1);
+        assertThat(evaluator.failures(List.of(any), claim(Map.of("acknowledged", true)), Instant.EPOCH)).isEmpty();
+    }
+
+    @Test
+    void timestampGuardsFailClosedForMalformedValuesAndCompareAtMicrosecondPrecision() {
+        var afterLastRequest = guard("after", "receivedAt", "lastInformationRequestedAt", null);
+        ClaimSnapshot malformed = new ClaimSnapshot(UUID.randomUUID(), "member-1", "PENDING_INFO",
+                BigDecimal.TEN, "USD", Map.of("receivedAt", "yesterday"), 1, 0, null,
+                Instant.parse("2026-10-16T00:00:00Z"));
+        assertThat(evaluator.failures(List.of(afterLastRequest), malformed, Instant.EPOCH)).hasSize(1);
+
+        ClaimSnapshot exactAtRoundedBoundary = new ClaimSnapshot(UUID.randomUUID(), "member-1", "PENDING_INFO",
+                BigDecimal.TEN, "USD", Map.of("receivedAt", "2026-10-16T00:00:00.0000008Z"), 1, 0, null,
+                Instant.parse("2026-10-16T00:00:00.000000Z"));
+        assertThat(evaluator.failures(List.of(afterLastRequest), exactAtRoundedBoundary,
+                Instant.parse("2026-10-16T00:00:01Z"))).isEmpty();
+    }
+}
