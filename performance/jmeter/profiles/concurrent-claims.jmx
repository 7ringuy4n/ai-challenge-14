              <stringProp name="parameters" />
              <stringProp name="script">def body = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()); vars.put("claimId", body.id.toString()); vars.put("version", body.version.toString())</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
